          "text": "Instead of writing every repeat, a compressor can store a phrase once."
        },
        {
          "id": "dictionary-reference",
          "scene": "dictionary",
          "text": "Later repeats become short references to that earlier phrase."
        },
        {
          "id": "bits-translate",
          "scene": "bits",
          "text": "The remaining symbols are then translated into bits."
        },
        {
          "id": "bits-common",
          "scene": "bits",
          "text": "Common symbols can use shorter bit patterns than rare ones."
        },
        {
          "id": "unpack-rebuild",
          "scene": "unpack",
          "text": "To open the file, the reader follows the references and rebuilds every original character."
        },
        {
          "id": "unpack-exact",
          "scene": "unpack",
          "text": "Nothing is guessed. Nothing is lost."
        },
        {
          "id": "limit-random",
          "scene": "limit",
          "text": "But already-compressed data may barely shrink."
        },
        {
          "id": "limit-structure",
          "scene": "limit",
          "text": "ZIP saves space only when it finds useful structure."
        },
        {
          "id": "closing-summary",
          "scene": "closing",
          "text": "Compression is not deleting information. It is writing the same information more efficiently."
        }
