          "text": "Press play on your phone."
        },
        {
          "id": "hook-travel",
          "scene": "hook",
          "text": "The music reaches your headphones without a cable."
        },
        {
          "id": "encode-samples",
          "scene": "encode",
          "text": "First, the phone represents the music as digital audio samples."
        },
        {
          "id": "encode-compress",
          "scene": "encode",
          "text": "Bluetooth usually compresses those samples so they fit within the available data rate."
        },
        {
          "id": "packets-chop",
          "scene": "packets",
          "text": "The compressed stream is divided into small packets."
        },
        {
          "id": "packets-control",
          "scene": "packets",
          "text": "Each packet carries control information alongside the audio data."
        },
        {
          "id": "radio-pair",
          "scene": "radio",
          "text": "The paired devices transmit these packets over short-range radio."
        },
        {
          "id": "radio-hop",
          "scene": "radio",
          "text": "They rapidly change frequencies in a coordinated pattern, helping avoid interference."
        },
        {
          "id": "receive-check",
          "scene": "receive",
          "text": "Your headphones receive the packets and check that the data arrived correctly."
        },
        {
          "id": "receive-decode",
          "scene": "receive",
          "text": "They reassemble and decode the audio stream."
        },
        {
          "id": "closing-summary",
          "scene": "closing",
          "text": "Digital samples become radio packets, then become music again through the headphone's converter and driver."
        }
