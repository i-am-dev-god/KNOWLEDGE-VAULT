  "vo": [
    {
      "id": "hook-blur",
      "scene": "hook",
      "text": "In portrait mode, your phone keeps you sharp while the background turns soft and blurry.",
      "start": 0.15,
      "end": 5.735
    },
    {
      "id": "hook-not-lens",
      "scene": "hook",
      "text": "That blur is not from a large lens. It is added after the photo is taken.",
      "start": 5.735,
      "end": 10.368
    },
    {
      "id": "capture-two",
      "scene": "capture",
      "text": "The phone captures the same scene with two lenses or two focus positions to measure depth.",
      "start": 10.368,
      "end": 16.08
    },
    {
      "id": "depth-map",
      "scene": "depth",
      "text": "Software builds a depth map, marking how far each part of the picture is from the camera.",
      "start": 16.08,
      "end": 21.728
    },
    {
      "id": "cut-person",
      "scene": "cutout",
      "text": "It then cuts out the person as the sharp foreground.",
      "start": 21.728,
      "end": 25.028
    },
    {
      "id": "blur-background",
      "scene": "blur",
      "text": "Everything marked as background is blurred with a soft bokeh effect.",
      "start": 25.028,
      "end": 29.344
    },
    {
      "id": "edge-hair",
      "scene": "edge",
      "text": "Edge refinement keeps difficult areas like hair sharp while the rest of the background stays blurred.",
      "start": 29.344,
      "end": 35.754
    },
    {
      "id": "closing-summary",
      "scene": "closing",
      "text": "So measured depth and a precise cutout turn a regular photo into a portrait with blurred background.",
      "start": 35.754,
      "end": 42.1
    }
