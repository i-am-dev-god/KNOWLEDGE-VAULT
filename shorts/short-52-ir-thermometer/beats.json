  "vo": [
    {
      "id": "hook-point",
      "scene": "hook",
      "text": "Point this thermometer, press the trigger, and you get a temperature without touching anything.",
      "start": 0.15,
      "end": 5.95
    },
    {
      "id": "hook-infrared",
      "scene": "hook",
      "text": "It does not measure air. It measures invisible infrared light coming from the surface.",
      "start": 5.95,
      "end": 11.2
    },
    {
      "id": "lens-focus",
      "scene": "lens",
      "text": "A lens gathers that infrared radiation and focuses it onto a tiny detector.",
      "start": 11.2,
      "end": 15.779
    },
    {
      "id": "filter-band",
      "scene": "filter",
      "text": "A filter keeps only the heat-related wavelengths and blocks other light.",
      "start": 15.779,
      "end": 20.174
    },
    {
      "id": "sensor-voltage",
      "scene": "sensor",
      "text": "The thermopile detector turns that focused heat into a small voltage.",
      "start": 20.174,
      "end": 24.387
    },
    {
      "id": "process-table",
      "scene": "process",
      "text": "Electronics compare that voltage to a calibration table to determine temperature.",
      "start": 24.387,
      "end": 29.332
    },
    {
      "id": "display-emissivity",
      "scene": "display",
      "text": "Settings like emissivity adjust the reading for different surface materials.",
      "start": 29.332,
      "end": 33.972
    },
    {
      "id": "closing-summary",
      "scene": "closing",
      "text": "So focused infrared light becomes a voltage, and that voltage becomes a temperature.",
      "start": 33.972,
      "end": 39.1
    }
